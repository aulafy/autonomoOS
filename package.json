{
  "name": "agent-world-os",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "pymes"
  ],
  "scripts": {
    "dev:world": "npm --workspace apps/world-client run dev",
    "dev:runtime": "npm --workspace apps/agent-runtime run dev",
    "demo:company": "bash scripts/demo-company.sh",
    "demo:pymes": "npm --workspace pymes run dev",
    "check:pymes": "npm run check --workspace=@agent-world/pymes",
    "check:operations": "npm run check:operations --workspace=@agent-world/pymes",
    "check:openclaw-contract": "bash scripts/check-openclaw-contract.sh",
    "check:product": "npm run check:openclaw-contract && npm run check --workspace=@agent-world/pymes && npm run check:k8s",
    "check:k8s": "bash scripts/check-k8s-manifest.sh",
    "demo:h3": "tsx apps/agent-runtime/src/h3-demo.ts",
    "demo:h4": "tsx apps/agent-runtime/src/h4-demo.ts",
    "demo:h4:lost-response": "tsx apps/agent-runtime/src/h4-lost-response-demo.ts",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
