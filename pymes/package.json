{
  "name": "@agent-world/pymes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "api": "tsx src/server.ts",
    "pilot:read": "tsx src/pilot-read.ts",
    "pilot:classify": "tsx src/pilot-classify.ts",
    "pilot:evaluate": "tsx src/evaluate-classifier.ts",
    "check:operations": "bash scripts/check-operations.sh",
    "validate:production-env": "bash scripts/validate-production-env.sh",
    "build": "vite build",
    "check": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
