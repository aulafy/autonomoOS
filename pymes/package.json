{
  "name": "@agent-world/pymes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "api": "tsx src/server.ts",
    "pilot:read": "tsx src/pilot-read.ts",
    "pilot:classify": "tsx src/pilot-classify.ts",
    "pilot:evaluate": "tsx src/evaluate-classifier.ts",
    "check:operations": "bash scripts/check-operations.sh",
    "validate:production-env": "bash scripts/validate-production-env.sh",
    "build": "vite build",
    "check": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "diagnose:mac": "bash scripts/mac-diagnostics.sh",
    "benchmark:local": "tsx src/benchmark-local.ts",
    "start:ui": "tsx src/ui-server.ts",
    "mac:launch-agent": "tsx src/mac-launch-agent.ts",
    "gmail:build-keychain": "bash scripts/build-gmail-keychain.sh",
    "p01:kill": "tsx src/p01-pilot-kill.ts"
