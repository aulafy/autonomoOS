  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@agent-world/task-runtime": "0.1.0",
    "@agent-world/inference": "0.1.0",
    "@agent-world/runtime-store-sqlite": "0.1.0",
    "@agent-world/control-plane": "0.1.0",
    "@agent-world/composition-policy": "0.1.0",
    "@agent-world/contracts": "0.1.0",
    "@agent-world/effects": "0.1.0",
    "@agent-world/information-flow": "0.1.0",
    "@agent-world/leases": "0.1.0",
    "@agent-world/observation": "0.1.0",
    "@agent-world/reconciliation": "0.1.0",
    "@agent-world/recovery": "0.1.0",
    "@agent-world/resources": "0.1.0",
    "@agent-world/supervision": "0.1.0"
  }
}
