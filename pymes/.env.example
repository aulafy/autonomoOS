# Workspace server
PYMES_API_PORT=8790
PYMES_API_HOST=0.0.0.0
PYMES_API_DB_PATH=/data/pymes-workspace.db
PYMES_API_VERSION=0.1.0
PYMES_API_BOOTSTRAP_TOKEN=replace-with-at-least-16-characters
PYMES_API_BOOTSTRAP_TENANT=demo-agency
PYMES_API_BOOTSTRAP_USER=demo-owner
# Producción: sustituye estos orígenes por los dominios exactos de la interfaz; no uses '*'.
PYMES_API_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# Optional OpenClaw Enterprise ingress
PYMES_OPENCLAW_INGRESS_TOKEN=
PYMES_OPENCLAW_SIGNING_SECRET=
PYMES_OPENCLAW_AGENT_IDS=
PYMES_OPENCLAW_RESOURCE_IDS=
PYMES_OPENCLAW_CHANNELS=whatsapp,telegram,imessage,email
PYMES_OPENCLAW_PAIRED_SENDERS=
PYMES_OPENCLAW_CONSENTED_CONVERSATIONS=
PYMES_OPENCLAW_MAX_EVENT_AGE_MS=604800000
PYMES_OPENCLAW_MAX_FUTURE_SKEW_MS=600000
