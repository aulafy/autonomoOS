# Workspace server
PYMES_API_PORT=8790
PYMES_API_HOST=0.0.0.0
PYMES_API_DB_PATH=/data/pymes-workspace.db
PYMES_API_VERSION=0.1.0
PYMES_API_BOOTSTRAP_TOKEN=replace-with-at-least-16-characters
PYMES_API_BOOTSTRAP_TENANT=demo-agency
PYMES_API_BOOTSTRAP_USER=demo-owner
PYMES_API_WORKER_TOKEN=
PYMES_API_WORKER_ID=effects-worker
# Producción: sustituye estos orígenes por los dominios exactos de la interfaz; no uses '*'.
PYMES_API_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# Optional OpenClaw Enterprise ingress
PYMES_OPENCLAW_INGRESS_TOKEN=
PYMES_OPENCLAW_SIGNING_SECRET=
PYMES_OPENCLAW_AGENT_ID=whatsapp-agent
PYMES_OPENCLAW_RESOURCE_ID=whatsapp-business
PYMES_OPENCLAW_AGENT_IDS=
PYMES_OPENCLAW_RESOURCE_IDS=
PYMES_OPENCLAW_CHANNELS=whatsapp,telegram,imessage,email
PYMES_OPENCLAW_PAIRED_SENDERS=
PYMES_OPENCLAW_CONSENTED_CONVERSATIONS=
PYMES_OPENCLAW_MAX_EVENT_AGE_MS=604800000
PYMES_OPENCLAW_MAX_FUTURE_SKEW_MS=600000

# Optional outbound provider gateways (only workers use these values)
PYMES_MESSAGE_GATEWAY_URL=
PYMES_MESSAGE_GATEWAY_TOKEN=
# Optional direct Meta WhatsApp Cloud API (worker only)
PYMES_WHATSAPP_CLOUD_ACCESS_TOKEN=
PYMES_WHATSAPP_CLOUD_PHONE_NUMBER_ID=
PYMES_WHATSAPP_CLOUD_API_VERSION=v23.0
PYMES_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
PYMES_WHATSAPP_APP_SECRET=
PYMES_CRM_GATEWAY_URL=
PYMES_CRM_GATEWAY_TOKEN=
PYMES_CALL_GATEWAY_URL=
PYMES_CALL_GATEWAY_TOKEN=

# Monitoring script (used by npm run check:operations; keep its token separate)
PYMES_API_BASE_URL=http://127.0.0.1:8790
PYMES_API_TOKEN=replace-with-a-dedicated-monitor-token
PYMES_API_TENANT=demo-agency
PYMES_API_TIMEOUT_SECONDS=10
PYMES_PENDING_REVIEW_LIMIT=20

# Optional local LLM (Ollama)
PYMES_LOCAL_MODEL=llama3.2:3b
PYMES_LOCAL_LLM_URL=http://127.0.0.1:11434

# Optional Telegram Bot API inbound connector (Mac local installation).
# When enabled, set PYMES_API_HOST=127.0.0.1 above.
# Configure the bot token and consented chat IDs in the UI; never put tokens here.
PYMES_TELEGRAM_ENABLED=0
PYMES_TELEGRAM_KEYCHAIN_HELPER=
